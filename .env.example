# Chave de envio do Resend, usada apenas pelo servidor. Não use REACT_APP_.
RESEND_API_KEY=
# Use um remetente pertencente ao domínio/subdomínio verificado no Resend.
MAIL_FROM="Cuby Digital <site@notificacoes.cuby.com.br>"
# O destinatário é fixo no servidor: contato@cuby.com.br.
# API_PORT=3001
# Na Vercel, configure apenas RESEND_API_KEY e MAIL_FROM no ambiente Production.
# Para um servidor próprio, defina HOST=0.0.0.0 e PORT conforme sua hospedagem.
# Ative apenas se a aplicação estiver atrás de um proxy que sobrescreve os cabeçalhos encaminhados.
# TRUST_PROXY=true
